{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "bun run validate-env && bun run scripts/generate-pwa-icons.ts && astro build && bun run scripts/generate-cache-manifest.ts",
    "build:skip-validation": "bun run scripts/generate-pwa-icons.ts && astro build && bun run scripts/generate-cache-manifest.ts",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "validate-env": "bun run scripts/validate-env.ts",
    "validate-translations": "bun run scripts/validate-translations.ts",
    "validate-translations:locale": "bun run scripts/validate-translations.ts --locale=",
    "validate-translations:component": "bun run scripts/validate-translations.ts --component=",
    "sw:clear": "bun run scripts/uninstall-sw.ts",
    "deploy:vercel": "./scripts/deploy.sh vercel production",
    "deploy:vercel:preview": "./scripts/deploy.sh vercel preview",
    "deploy:netlify": "./scripts/deploy.sh netlify production",
    "deploy:netlify:preview": "./scripts/deploy.sh netlify preview",
    "rollback:vercel": "./scripts/rollback.sh vercel",
    "rollback:netlify": "./scripts/rollback.sh netlify"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.0",
    "@nanostores/persistent": "^1.2.0",
    "@supabase/supabase-js": "^2.80.0",
    "@tanstack/solid-virtual": "^3.10.8",
    "astro": "^7.0.0",
    "idb": "^8.0.3",
    "nanostores": "^1.0.1",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.10",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@nanostores/solid": "^1.1.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/ui": "^4.0.7",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.1.0",
    "sharp": "^0.35.0",
    "terser": "^5.36.0",
    "unocss": "^66.5.4",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.7"
  }
}
